# Covers JetBrains IDEs: IntelliJ, GoLand, RubyMine, PhpStorm, AppCode, PyCharm, CLion, Android Studio, WebStorm and Rider
# Reference: https://github.com/github/gitignore/blob/master/Global/JetBrains.gitignore

**/.[Ie]dea/
*.iml
*.iws
*.ipr

# User-specific files
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/dictionary.xml
.idea/shelf/

# AWS User Configurations
.idea/aws.xml

# Generated files
.idea/caches/build_file_checksums.ser

# Sensitive / Local Data Sources
.idea/dataSources/
.idea/dataSources.local.xml
.idea/dataSources.ids
.idea/sqlDataSources.xml
.idea/dynamic.xml
.idea/uiDesigner.xml
.idea/dbnavigator.xml

# Gradle / Maven local configurations
.idea/gradle.xml
.idea/compiler.xml
.idea/jarRepositories.xml

# Log files
*.log

# Android Studio / IntelliJ Android fragments
/local.properties
.navigation/
captures/
.externalNativeBuild/
.cxx/
cmake-build-*/